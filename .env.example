# Inventory only: all values are intentionally empty, not a runnable env file.
# config.py reads process variables. Privately set only needed values.
# Omit unused optional/numeric settings to retain defaults; never import all blanks.
# Main / compatibility / secondary server-side gateways (no bundled endpoints).
MODEL_GATEWAY_BASE_URL=
MODEL_GATEWAY_API_KEY=
GATEWAY_COMPAT_BASE_URL=
GATEWAY_COMPAT_API_KEY=
GATEWAY_COMPAT_API_KEYS=
