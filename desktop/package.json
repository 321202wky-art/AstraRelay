{
  "name": "astrarelay-desktop",
  "productName": "AstraRelay",
  "version": "0.1.0",
  "private": true,
  "description": "AstraRelay Windows desktop collaboration workbench",
  "author": "AstraRelay",
  "main": "src/main.cjs",
  "scripts": {
    "build:editor": "node scripts/build-editor.cjs",
    "test": "node --test tests/*.test.cjs",
    "prestart": "npm run build:editor",
    "start": "electron-forge start",
    "prepackage": "npm run build:editor && node scripts/check-packaging-node.cjs",
    "package": "electron-forge package --arch=x64",
    "premake": "node scripts/check-packaging-node.cjs",
    "make": "electron-forge make --arch=x64"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@electron/fuses-modern": "npm:@electron/fuses@2.1.3",
    "electron": "43.2.0",
    "esbuild": "0.25.0"
  },
  "dependencies": {
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-javascript": "6.2.3",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.36.5",
    "electron-squirrel-startup": "1.0.1"
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7"
  }
}
